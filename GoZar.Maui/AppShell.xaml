<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="GoZar.Maui.AppShell" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Go Zar" FlyoutBehavior="Disabled" FlowDirection="RightToLeft">
    <FlyoutItem x:Name="AuthenticationItem" Route="authentication" Title="گذر">
        <ShellContent x:Name="WelcomeContent" Route="welcome" Title="خوش آمدی" />
    </FlyoutItem>
    <TabBar x:Name="MainTabs" Route="main" IsVisible="False">
        <Tab Route="today" Title="امروز"><ShellContent x:Name="TodayContent" Route="today-root" /></Tab>
        <Tab Route="map" Title="نقشه"><ShellContent x:Name="MapContent" Route="map-root" /></Tab>
        <Tab Route="stories" Title="کشف"><ShellContent x:Name="StoriesContent" Route="stories-root" /></Tab>
        <Tab Route="profile" Title="من"><ShellContent x:Name="ProgressContent" Route="profile-root" /></Tab>
    </TabBar>
</Shell>
