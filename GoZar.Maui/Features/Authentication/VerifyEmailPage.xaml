<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GoZar.Maui.Features.Authentication"
             xmlns:shared="clr-namespace:GoZar.Maui.Shared.Controls"
             x:Class="GoZar.Maui.Features.Authentication.VerifyEmailPage" x:DataType="vm:VerifyEmailViewModel"
             Title="{Binding Title}" FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Ivory}, Dark={StaticResource DarkBackground}}">
    <ScrollView><VerticalStackLayout>
        <shared:ScaffoldView />
        <VerticalStackLayout Spacing="12" Padding="24,0,24,24">
            <Label Text="کد تأیید (روش هنوز مشخص نشده)" />
            <Entry Text="{Binding VerificationCode}" Placeholder="کد تأیید (روش هنوز مشخص نشده)" Keyboard="Default" IsPassword="False" FlowDirection="LeftToRight" SemanticProperties.Description="کد تأیید (روش هنوز مشخص نشده)" />
            <!-- TODO : Enable submission after wiring validation and the real authentication API. -->
            <Button Text="اتصال به API هنوز پیاده‌سازی نشده" IsEnabled="False" />
        </VerticalStackLayout>
    </VerticalStackLayout></ScrollView>
</ContentPage>
