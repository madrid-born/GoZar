<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GoZar.Maui.Features.Stories"
             xmlns:shared="clr-namespace:GoZar.Maui.Shared.Controls"
             x:Class="GoZar.Maui.Features.Stories.StoriesPage" x:DataType="vm:StoriesViewModel"
             Title="{Binding Title}" FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource Ivory}, Dark={StaticResource DarkBackground}}">
    <ScrollView><VerticalStackLayout>
        <shared:ScaffoldView />
    </VerticalStackLayout></ScrollView>
</ContentPage>
