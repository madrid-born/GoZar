<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- TODO : Choose and license a Persian UI font; validate native shaping and font scaling. -->
    <Style x:Key="HeadingLabel" TargetType="Label">
        <Setter Property="FontSize" Value="27" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Chocolate}, Dark={StaticResource Ivory}}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Chocolate}, Dark={StaticResource Ivory}}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Chocolate}, Dark={StaticResource Ivory}}" />
    </Style>
    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Chocolate}, Dark={StaticResource Ivory}}" />
    </Style>
</ResourceDictionary>
